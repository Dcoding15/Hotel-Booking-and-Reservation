PORT=4000
CLIENT_URL=http://localhost:5173

# Local MongoDB Community Server; start MongoDB before starting the API.
MONGO_URI=mongodb://127.0.0.1:27017/roomkey
# If local MongoDB authentication is enabled, replace the line above with your own credentials:
# MONGO_URI=mongodb://<username>:<password>@127.0.0.1:27017/roomkey?authSource=admin

# PostgreSQL is also required by the API.
DATABASE_URL=postgresql://postgres:nopass@localhost:5432/roomkey

# Use a long, private value; do not commit real secrets.
JWT_SECRET=<replace-with-a-long-random-secret>

# Set these in server/.env, run `npm run seed` from server, then sign in with them as admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<replace-with-a-strong-admin-password>

# Razorpay Dashboard test-mode credentials. Never use a live secret for local testing.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=<replace-with-your-test-key-secret>

# Optional; the application can run without Redis.
REDIS_URL=redis://127.0.0.1:6379
